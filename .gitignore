# Generated by Cargo
# will have compiled files and executables
debug
target

# Stray rlib build artifacts (e.g. from an ad-hoc `rustc file.rs` in the tree);
# the canonical ones live under target/, already ignored above.
*.rlib

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# mdBook output
book/output/

# JSON schemas generated in the wrong directory (canonical location: book/src/schemas/)
/*.schema.json

# Implementation plans (local development only); the quality-evaluation ledger
# and tooling are tracked so its work sessions have git evidence
plans/*
!plans/architecture-debt-audit/

# Claude Code — track project rules and hooks, ignore ephemeral state
.claude/*
!.claude/architecture-rules.md
!.claude/settings.json
!.claude/hooks/
!.claude/rules/
assessment*.md

# Stale vendor directory (real HiGHS submodule is at crates/cobre-solver/vendor/)
vendor/
# Track our authored COIN-OR superbuild glue (config headers + CMakeLists) under
# crates/cobre-solver/vendor/coin-build/. Submodule contents (HiGHS/Clp/CoinUtils)
# stay ignored — they are gitlinks tracked separately, not regular files.
!crates/cobre-solver/vendor/
crates/cobre-solver/vendor/*
!crates/cobre-solver/vendor/coin-build/
# qhull is vendored as a git submodule under crates/cobre-sddp/vendor/qhull,
# exactly like the solver submodules above: un-ignore the vendor dir so the
# gitlink is visible, then re-ignore its contents (a gitlink is tracked via
# .gitmodules + the index, not as regular files).
!crates/cobre-sddp/vendor/
crates/cobre-sddp/vendor/*

# Python virtual environments (test infrastructure)
.venv-mpi-smoke/

# Examples
examples/**/output

# Terminal recording temporary files
recordings/demo/
__pycache__/

# Python bindings
.venv.claude/
doc/
tests/slurm/staging/
dhat-heap.json
*.orig
rust_out
.specforge/
.specforge-canary/
.mcp.json
