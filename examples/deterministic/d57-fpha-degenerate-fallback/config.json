{
  "$schema": "https://raw.githubusercontent.com/cobre-rs/cobre/refs/heads/main/schemas/config.schema.json",
  "training": {
    "selection": {
      "method": "sampled",
      "forward_passes": 1
    },
    "stopping_rules": [
      {
        "type": "iteration_limit",
        "limit": 10
      }
    ]
  },
  "simulation": {
    "enabled": true
  },
  "modeling": {
    "inflow_non_negativity": {
      "method": "none"
    }
  }
}
